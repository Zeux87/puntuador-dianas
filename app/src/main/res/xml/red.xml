<?xml version="1.0" encoding="utf-8"?>
<!-- El lector de impactos (ESP32 o la app Lector en otro móvil) habla HTTP sin cifrar dentro de su propia red WiFi,
     y su dirección no es fija (la puerta de enlace de la zona WiFi del móvil). Las conexiones a internet siguen siendo HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
